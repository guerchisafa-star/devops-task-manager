{
  "info": {
    "name": "Task Manager API",
    "description": "Collection de tests pour l'API REST Task Manager",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Créer une tâche",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "http://localhost:8080/api/tasks", "host": ["localhost"], "port": "8080", "path": ["api", "tasks"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Rédiger le rapport\",\n  \"description\": \"Rapport mensuel de novembre\",\n  \"dueDate\": \"2025-11-30\",\n  \"priority\": \"HIGH\",\n  \"status\": \"TODO\"\n}"
        }
      }
    },
    {
      "name": "Créer une tâche — titre manquant (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "http://localhost:8080/api/tasks", "host": ["localhost"], "port": "8080", "path": ["api", "tasks"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Pas de titre\"\n}"
        }
      }
    },
    {
      "name": "Récupérer toutes les tâches",
      "request": {
        "method": "GET",
        "url": { "raw": "http://localhost:8080/api/tasks", "host": ["localhost"], "port": "8080", "path": ["api", "tasks"] }
      }
    },
    {
      "name": "Récupérer une tâche par ID",
      "request": {
        "method": "GET",
        "url": { "raw": "http://localhost:8080/api/tasks/1", "host": ["localhost"], "port": "8080", "path": ["api", "tasks", "1"] }
      }
    },
    {
      "name": "Récupérer une tâche — ID inexistant (404)",
      "request": {
        "method": "GET",
        "url": { "raw": "http://localhost:8080/api/tasks/999", "host": ["localhost"], "port": "8080", "path": ["api", "tasks", "999"] }
      }
    },
    {
      "name": "Modifier une tâche",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "http://localhost:8080/api/tasks/1", "host": ["localhost"], "port": "8080", "path": ["api", "tasks", "1"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Rapport final\",\n  \"description\": \"Version définitive\",\n  \"dueDate\": \"2025-12-15\",\n  \"priority\": \"MEDIUM\",\n  \"status\": \"IN_PROGRESS\"\n}"
        }
      }
    },
    {
      "name": "Supprimer une tâche",
      "request": {
        "method": "DELETE",
        "url": { "raw": "http://localhost:8080/api/tasks/1", "host": ["localhost"], "port": "8080", "path": ["api", "tasks", "1"] }
      }
    },
    {
      "name": "Supprimer une tâche — ID inexistant (404)",
      "request": {
        "method": "DELETE",
        "url": { "raw": "http://localhost:8080/api/tasks/999", "host": ["localhost"], "port": "8080", "path": ["api", "tasks", "999"] }
      }
    }
  ]
}
